
class Context(_GenContext):
    """A CUI context. Built directly, it renders headless with the software renderer."""
    def __init__(self, width: float = 800, height: float = 600, scale: float = 1.0, *,
                 theme: int = 0, accent: int = 0, reduced_motion: bool = False,
                 default_fonts: bool = True) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> bool: ...
    @property
    def in_frame(self) -> bool: ...
    @property
    def clipboard(self) -> str: ...
    @clipboard.setter
    def clipboard(self, value: str) -> None: ...
    def begin_frame(self, dt: float = ...) -> None: ...
    def end_frame(self) -> None: ...
    def frame(self, dt: float = ...) -> Any: ...
    def canvas(self, id: str, width: SizeLike, height: SizeLike,
               paint: Callable[[Rect], object] | None = None) -> CanvasResult: ...
    def image_create(self, width: int, height: int, rgba: bytes) -> int: ...
    def font_load_memory(self, data: bytes) -> int: ...
    def emoji_font_load_memory(self, data: bytes) -> bool: ...
    def draw_counts(self) -> tuple[int, int, int]: ...
    def render_size(self) -> tuple[int, int]: ...
    def render(self) -> bytes: ...
    def save_png(self, path: str | os.PathLike[str]) -> None: ...
    def close(self) -> None: ...

class App:
    """A native window with an event loop. `for ui in app.frames(): ...`"""
    def __init__(self, title: str = "CUI", width: int = 1080, height: int = 720, *,
                 min_width: int = 0, min_height: int = 0, fixed_size: bool = False,
                 continuous: bool = False, no_vsync: bool = False, hidden: bool = False,
                 renderer: int = 0, theme: int = 0, accent: int = 0,
                 follow_system_theme: bool = False, app_id: str | None = None) -> None: ...
    @property
    def ui(self) -> Context: ...
    def frame(self) -> bool: ...
    def frames(self) -> Iterator[Context]: ...
    def run(self, fn: Callable[[Context], object]) -> None: ...
    def quit(self) -> None: ...
    def set_title(self, title: str) -> None: ...
    def set_size(self, width: int, height: int) -> None: ...
    def size(self) -> Vec2: ...
    def is_software(self) -> bool: ...
    def backend(self) -> str: ...
    def screenshot(self) -> tuple[int, int, bytes]: ...
    def file_dialog(self, kind: int = 0, title: str | None = None, filter_name: str | None = None,
                    filter: str | None = None, default_name: str | None = None) -> str | None: ...
    def close(self) -> None: ...
    def __enter__(self) -> Self: ...
    def __exit__(self, *exc: object) -> bool: ...

def open_url(url: str) -> bool: ...
def write_png(path: str | os.PathLike[str], rgba: bytes, width: int, height: int) -> None: ...

