        self._need_frame()
        cdef const char * c_id
        cdef size_t c_offset
        c_id = _cstr(self._keep, id)
        c_offset = <size_t>offset
        cui_hex_view_goto(self.ui, c_id, c_offset)

    def flame_graph(self, str id not None, spans, view, selected, *, width=None, height=None, row_height=None, min_range=None):
        """selected: index into spans, -1 for none (may be NULL)."""
        self._need_frame()
        cdef const char * c_id
        cdef _Mem c_spans
        cdef int c_count
        cdef cui_flame_view c_view
        cdef int c_selected
        cdef cui_flame_opts c_opts
        c_id = _cstr(self._keep, id)
        c_spans = _arr_cui_flame_span(spans, self._keep)
        c_view = _to_cui_flame_view(view)
        c_selected = <int>selected
        memset(&c_opts, 0, sizeof(c_opts))
        if width is not None: c_opts.width = _to_cui_size(width)
        if height is not None: c_opts.height = <float>height
        if row_height is not None: c_opts.row_height = <float>row_height
