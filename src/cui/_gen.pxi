def flame_sort(spans):
    """Sorts spans into the order the graph needs: by depth, then start (longer
first on ties)."""
    cdef list keep = []
    cdef _Mem c_spans
    cdef int c_count
    c_spans = _arr_cui_flame_span(spans, keep)
    c_count = <int>c_spans.n
    cui_flame_sort(<cui_flame_span *>c_spans.ptr, c_count)
    return _list_cui_flame_span(c_spans)

def curve_eval(keys, x):
    """The curve's value at x: exactly what the editor draws. keys sorted by x."""
    cdef list keep = []
    cdef _Mem c_keys
    cdef int c_count
    cdef float c_x
    c_keys = _arr_cui_curve_key(keys, keep)
    c_x = <float>x
    c_count = <int>c_keys.n
    cdef float r = cui_curve_eval(<cui_curve_key *>c_keys.ptr, c_count, c_x)
    return r

def gradient_eval(stops, t):
    """The color at t: exactly what the ramp shows (each channel, alpha too,
interpolated in sRGB between the stops on either side; the end colors
continue past the first and last stop)."""
    cdef list keep = []
    cdef _Mem c_stops
    cdef int c_count
    cdef float c_t
    c_stops = _arr_cui_gradient_stop(stops, keep)
    c_t = <float>t
    c_count = <int>c_stops.n
    cdef cui_color r = cui_gradient_eval(<cui_gradient_stop *>c_stops.ptr, c_count, c_t)
    return _from_cui_color(r)

def query_op_name(type, op):
    """the operators of a type: text "is", "is not", "contains", "does not contain",
"starts with", "ends with"; number "=", "!=", ">", ">=", "<", "<="; choice
"is", "is not"; bool "is true", "is false". NULL past the last."""
    cdef list keep = []
    cdef cui_query_type c_type
    cdef int c_op
    c_type = <cui_query_type><int>type
    c_op = <int>op
    cdef const char * r = cui_query_op_name(c_type, c_op)
    return _str_or_none(r)

def cron_next(str cron not None, after, utc_offset):
    """The first time after `after` (Unix seconds) the expression matches, in the
time zone that is utc_offset minutes east of UTC. Supports *, lists,
ranges, steps and the names JAN-DEC and SUN-SAT. False when it is invalid
or never runs in the next five years."""
    cdef list keep = []
    cdef const char * c_cron
    cdef int64_t c_after
    cdef int c_utc_offset
    cdef int64_t c_next
    c_cron = _cstr(keep, cron)
    c_after = <int64_t>after
    c_utc_offset = <int>utc_offset
    c_next = 0
    cdef cbool r = cui_cron_next(c_cron, c_after, c_utc_offset, &c_next)
    return (r, c_next)

