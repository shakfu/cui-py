cdef int _fill_cui_cal_event(cui_cal_event *v, object o, list keep) except -1:
    t = _record_tuple(o, ('title', 'detail', 'day', 'start', 'end', 'tone'), "CalEvent")
    if t[0] is not None: v.title = _cstr(keep, t[0])
    if t[1] is not None: v.detail = _cstr(keep, t[1])
    if t[2] is not None: v.day = <int>t[2]
    if t[3] is not None: v.start = <float>t[3]
    if t[4] is not None: v.end = <float>t[4]
    if t[5] is not None: v.tone = <cui_tone><int>t[5]
    return 0

cdef int _fill_cui_candle(cui_candle *v, object o, list keep) except -1:
    t = _record_tuple(o, ('open', 'high', 'low', 'close', 'volume'), "Candle")
    if t[0] is not None: v.open = <float>t[0]
    if t[1] is not None: v.high = <float>t[1]
    if t[2] is not None: v.low = <float>t[2]
    if t[3] is not None: v.close = <float>t[3]
    if t[4] is not None: v.volume = <float>t[4]
    return 0

cdef cui_candle _to_cui_candle(object o) except *:
    cdef cui_candle v
    memset(&v, 0, sizeof(v))
