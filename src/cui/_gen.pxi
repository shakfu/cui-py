        cdef cui_vec2 c_center
        cdef float c_radius
        cdef cui_color c_color
        c_center = _to_cui_vec2(center)
        c_radius = <float>radius
        c_color = _to_cui_color(color)
        cui_draw_circle(self.ui, c_center, c_radius, c_color)

    def draw_arc(self, center, radius, a0, a1, thickness, color):
        self._need_paint()
        cdef cui_vec2 c_center
        cdef float c_radius
        cdef float c_a0
        cdef float c_a1
        cdef float c_thickness
        cdef cui_color c_color
        c_center = _to_cui_vec2(center)
        c_radius = <float>radius
        c_a0 = <float>a0
        c_a1 = <float>a1
        c_thickness = <float>thickness
        c_color = _to_cui_color(color)
        cui_draw_arc(self.ui, c_center, c_radius, c_a0, c_a1, c_thickness, c_color)

    def draw_text(self, font, size, pos, color, str text not None):
        self._need_paint()
        cdef cui_font c_font
        cdef float c_size
        cdef cui_vec2 c_pos
        cdef cui_color c_color
        cdef const char * c_text
        cdef int c_len
        c_font = <cui_font>font
        c_size = <float>size
        c_pos = _to_cui_vec2(pos)
        c_color = _to_cui_color(color)
        c_text = _cstr(self._keep, text)
        c_len = <int>_cstr_len(self._keep, text)
        cui_draw_text(self.ui, c_font, c_size, c_pos, c_color, c_text, c_len)

    def draw_icon(self, str icon not None, r, size, color):
        self._need_paint()
        cdef const char * c_icon
        cdef cui_rect c_r
        cdef float c_size
        cdef cui_color c_color
        c_icon = _cstr(self._keep, icon)
        c_r = _to_cui_rect(r)
        c_size = <float>size
        c_color = _to_cui_color(color)
        cui_draw_icon(self.ui, c_icon, c_r, c_size, c_color)

    def draw_image(self, tex, r, uv, radius, tint):
        self._need_paint()
        cdef cui_texture c_tex
        cdef cui_rect c_r
        cdef cui_rect c_uv
        cdef cui_corners c_radius
        cdef cui_color c_tint
        c_tex = <cui_texture>tex
        c_r = _to_cui_rect(r)
        c_uv = _to_cui_rect(uv)
        c_radius = _to_cui_corners(radius)
        c_tint = _to_cui_color(tint)
        cui_draw_image(self.ui, c_tex, c_r, c_uv, c_radius, c_tint)

    def push_clip(self, r):
        self._need_paint()
        cdef cui_rect c_r
        c_r = _to_cui_rect(r)
        cui_push_clip(self.ui, c_r)

    def pop_clip(self):
        self._need_paint()
        cui_pop_clip(self.ui)

    def animate(self, id, target):
        """Animation helpers. Values move toward target with a spring and request
frames while moving. Reduced motion makes them snap."""
        self._need_frame()
        cdef cui_id c_id
        cdef float c_target
        c_id = <cui_id>id
        c_target = <float>target
        cdef float r = cui_animate(self.ui, c_id, c_target)
        return r

    def animate_spring(self, id, target, duration, bounce):
        self._need_frame()
        cdef cui_id c_id
        cdef float c_target
        cdef float c_duration
        cdef float c_bounce
        c_id = <cui_id>id
        c_target = <float>target
        c_duration = <float>duration
        c_bounce = <float>bounce
        cdef float r = cui_animate_spring(self.ui, c_id, c_target, c_duration, c_bounce)
        return r



