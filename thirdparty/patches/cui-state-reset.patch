+/* Free what an entry's data owns and the data itself. */
+static void cui__state_drop_data(cui_ctx *ui, cui_state_entry *e) {
+    if (e->dtor && e->data) e->dtor(ui, e->data);
+    if (ui->edit && (void *)ui->edit == e->data) ui->edit = NULL;
+    cui__free(ui, e->data);
+    e->data = NULL;
+    e->size = 0;
+    e->dtor = NULL;
